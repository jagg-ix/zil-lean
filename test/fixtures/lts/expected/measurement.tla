---------------------------- MODULE lean4_integration_measurement_protocol_LTSBridge -----------------------------
(*
Generated by `zilInterop export-tla` from ZIL LTS_ATOM declarations.
*)

EXTENDS Sequences, FiniteSets, TLC

MeasurementRunStates == {
  "aborted",
  "acquiring",
  "analyzing",
  "archived",
  "calibrating",
  "idle"
}

MeasurementRunInitial == "idle"

MeasurementRunTransitions == {
  << "acquiring", "acquisition_done", "analyzing" >>,
  << "acquiring", "detector_fault", "aborted" >>,
  << "analyzing", "results_archived", "archived" >>,
  << "calibrating", "calibration_fail", "aborted" >>,
  << "calibrating", "calibration_ok", "acquiring" >>,
  << "idle", "begin_calibration", "calibrating" >>
}

MeasurementRunCanonicalTrace == <<
  << "measurementRun", "begin_calibration" >>,
  << "measurementRun", "calibration_fail" >>
>>

CanonicalSystemTrace == <<
  << "measurementRun", "begin_calibration" >>,
  << "measurementRun", "calibration_fail" >>
>>

