MODULE demo.bridge.lib.

// A domain macro library that builds on the shared model substrate with EMIT USE. The IDs it
// passes are its own, so the domain's facts and the substrate's facts describe the same subjects.
// Place this file in the same library directory as the substrate files (filenames 50 and above).

MACRO DEMO_COMPONENT(name, role):
EMIT demo:component:{{name}}#demo_role@value:{{role}}.
EMIT USE MODEL_ENTITY(demo:component:{{name}}).
EMIT USE MODEL_STATE(demo:state:{{name}}_idle, demo:component:{{name}}).
ENDMACRO.

MACRO DEMO_STORY(name, scenario, key):
EMIT USE SCENARIO_GIVEN(demo:step:{{name}}, {{scenario}}, 1, {{key}}).
ENDMACRO.
