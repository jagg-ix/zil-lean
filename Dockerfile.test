FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       bash ca-certificates curl git make python3 sqlite3 \
    && rm -rf /var/lib/apt/lists/*

RUN curl --fail --location --silent --show-error \
      https://elan.lean-lang.org/elan-init.sh \
      --output /tmp/elan-init.sh \
    && sh /tmp/elan-init.sh -y --default-toolchain none \
    && rm /tmp/elan-init.sh

ENV PATH="/root/.elan/bin:${PATH}"
ENV ZIL_CONTAINER=1

WORKDIR /workspace
COPY . /workspace

RUN chmod +x scripts/*.sh scripts/lib/*.sh bin/zil \
    && lake build

ENTRYPOINT ["bash", "scripts/test.sh"]
CMD ["--profile", "all", "--skip-build"]
