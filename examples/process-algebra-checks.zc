MODULE process.algebra.checks.example.

// A checkout protocol between a shop (the internal side, which must keep time moving) and a customer (the external side,
// which may be slow). Expand and query it with:
//   bin/zil query-ci examples/process-algebra-checks.zc checkout_profile - --lib libsets/process-algebra

// ---- who may wait, and who may not -----------------------------------------------------------------------------
USE TPL_VISIBLE(pay).
USE TPL_TAU(reserve_stock).
USE TPL_TAU(think).
USE TPL_PREFIX(customer_pays, pay, done).
USE TPL_SIDE(customer_pays, external).
USE TPL_PREFIX(shop_reserves, reserve_stock, done).
USE TPL_SIDE(shop_reserves, internal).
USE TPL_PREFIX(shop_waits_for_customer, pay, done).
USE TPL_SIDE(shop_waits_for_customer, internal).
USE TPL_PREFIX(shop_waits_for_courier, pay, done).
USE TPL_SIDE(shop_waits_for_courier, internal).
USE TPL_PREFIX(customer_deliberates, think, done).
USE TPL_SIDE(customer_deliberates, external).
USE TPL_NIL(done).

// ---- a hand-off with a partner and one without -----------------------------------------------------------------
USE PI_CHANNEL(payment).
USE PI_CHANNEL(refund).
USE PI_VALUE(order_total).
USE PI_NIL(finished).
USE PI_SEND(customer_send, payment, order_total, finished).
USE PI_RECV(shop_receive, payment, amount, finished).
USE PI_PAR(checkout, customer_send, shop_receive).
USE PI_SEND(lonely_send, refund, order_total, finished).
USE PI_RECV(lonely_receive, payment, amount, finished).
USE PI_PAR(broken_checkout, lonely_send, lonely_receive).

// ---- order of events across two actors -------------------------------------------------------------------------
USE VC_ACTOR(shop).
USE VC_ACTOR(carrier).
USE VC_COUNTER(c1).
USE VC_COUNTER(c2).
USE VC_COUNTER(c3).
USE VC_LT(c1, c2).
USE VC_LT(c2, c3).
USE VC_EVENT(packed).
USE VC_EVENT(shipped).
USE VC_EVENT(delivered).
USE VC_COMPONENT(packed, shop, c1).
USE VC_COMPONENT(shipped, shop, c2).
USE VC_COMPONENT(delivered, shop, c1).
USE VC_REQUIRE_BEFORE(packed, shipped).
USE VC_REQUIRE_BEFORE(shipped, delivered).

// ---- how old a quote may be ------------------------------------------------------------------------------------
USE TIME_TICK(t0).
USE TIME_TICK(t5).
USE TIME_TICK(t30).
USE TIME_LT(t0, t5).
USE TIME_LT(t5, t30).
USE TIME_AGE(fresh_quote, t5, t30).
USE TIME_AGE(stale_quote, t30, t5).
USE TIME_AGE(old_quote, t30, t0).
USE TIME_AGE(boundary_quote, t30, t30).

// ---- questions -------------------------------------------------------------------------------------------------
QUERY internal_steps_that_may_stall:
FIND ?p WHERE ?p#stalls_external@value:true.

QUERY external_steps_that_hold_time_up:
FIND ?p WHERE ?p#stalls_time@value:true.

QUERY handoffs_with_no_partner:
FIND ?p WHERE ?p#stuck@value:true.

QUERY handoffs_that_can_step:
FIND ?p WHERE ?p#can_tau@value:true.

QUERY orders_kept:
FIND ?a ?b WHERE ?a#order_kept@?b.

QUERY orders_broken:
FIND ?a ?b WHERE ?a#order_broken@?b.

QUERY quotes_within_window:
FIND ?o WHERE ?o#within_window@value:true.

QUERY quotes_past_window:
FIND ?o WHERE ?o#past_window@value:true.

QUERY_PACK checkout_pack [queries=[internal_steps_that_may_stall external_steps_that_hold_time_up handoffs_with_no_partner handoffs_that_can_step orders_kept orders_broken quotes_within_window quotes_past_window], must_return=[handoffs_that_can_step]].
DSL_PROFILE checkout_profile [query_pack=checkout_pack, planner_hint=high_selectivity_first, verification_chain=[query_ci]].
