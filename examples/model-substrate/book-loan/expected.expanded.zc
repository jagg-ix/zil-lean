MODULE example.book.lend.
book#model_kind@entity:model_entity.
loan#model_kind@entity:model_entity.
book_lend#model_kind@entity:model_op.
book#model_has_op@book_lend.
book_return#model_kind@entity:model_op.
book#model_has_op@book_return.
book_loans#model_kind@entity:model_assoc.
book_loans#model_source@book.
book_loans#model_target@loan.
book_loans#model_source_mult@value:one.
book_loans#model_target_mult@value:many.
shelved#model_kind@entity:model_state.
book#model_has_state@shelved.
lent#model_kind@entity:model_state.
book#model_has_state@lent.
shelved#model_initial@value:true.
first_loan#model_kind@entity:model_transition.
first_loan#model_from@shelved.
first_loan#model_event@value:lend.
first_loan#model_to@lent.
m_lend#model_kind@entity:model_message.
m_lend#model_from@reader_client.
m_lend#model_to@book.
m_lend#model_calls@book_lend.
reader#model_kind@entity:model_actor.
borrow_book#model_kind@entity:model_usecase.
return_book#model_kind@entity:model_usecase.
reader#model_participates@borrow_book.
reader#model_participates@return_book.
f_loan#scenario_kind@entity:scenario_feature.
f_loan#scenario_title@value:borrow_book.
s_first_loan#scenario_kind@entity:scenario_case.
f_loan#scenario_has_case@s_first_loan.
g1#scenario_kind@entity:scenario_step.
g1#scenario_keyword@value:given.
g1#scenario_ordinal@value:1.
g1#scenario_key@value:book_is_shelved.
s_first_loan#scenario_has_step@g1.
w1#scenario_kind@entity:scenario_step.
w1#scenario_keyword@value:when.
w1#scenario_ordinal@value:2.
w1#scenario_key@value:reader_borrows.
s_first_loan#scenario_has_step@w1.
t1#scenario_kind@entity:scenario_step.
t1#scenario_keyword@value:then.
t1#scenario_ordinal@value:3.
t1#scenario_key@value:book_is_lent.
s_first_loan#scenario_has_step@t1.
t2#scenario_kind@entity:scenario_step.
t2#scenario_keyword@value:then.
t2#scenario_ordinal@value:4.
t2#scenario_key@value:reader_has_a_loan.
s_first_loan#scenario_has_step@t2.
borrow_book#model_covered_by@s_first_loan.
w1#scenario_realizes@book_lend.
t1#scenario_realizes@first_loan.
RULE c_assoc_source_end:
IF ?a#model_source@?e
THEN ?a#model_end@?e.
RULE c_assoc_target_end:
IF ?a#model_target@?e
THEN ?a#model_end@?e.
RULE c_is_a_base:
IF ?c#model_is_a@?a
THEN ?c#model_is_a_star@?a.
RULE c_is_a_step:
IF ?c#model_is_a@?m AND ?m#model_is_a_star@?a
THEN ?c#model_is_a_star@?a.
RULE c_can_call:
IF ?m#model_from@?e AND ?m#model_calls@?op
THEN ?e#model_can_call@?op.
RULE c_has_coverage:
IF ?uc#model_covered_by@?s
THEN ?uc#model_has_coverage@value:true.
RULE c_link_by_coverage:
IF ?uc#model_covered_by@?s
THEN ?s#model_has_link@value:true.
RULE c_link_by_step:
IF ?s#scenario_has_step@?st AND ?st#scenario_realizes@?t
THEN ?s#model_has_link@value:true.
RULE c_has_realization:
IF ?st#scenario_realizes@?t
THEN ?st#scenario_has_realization@value:true.
QUERY c_uncovered_usecases:
FIND ?uc WHERE ?uc#model_kind@entity:model_usecase AND NOT ?uc#model_has_coverage@value:true.
QUERY c_orphan_scenarios:
FIND ?s WHERE ?s#scenario_kind@entity:scenario_case AND NOT ?s#model_has_link@value:true.
QUERY c_unrealized_then_steps:
FIND ?st WHERE ?st#scenario_keyword@value:then AND NOT ?st#scenario_has_realization@value:true.
QUERY loan_ends:
FIND ?e WHERE book_loans#model_end@?e.
QUERY loan_steps:
FIND ?st WHERE s_first_loan#scenario_has_step@?st.
QUERY operations_of_the_client:
FIND ?op WHERE reader_client#model_can_call@?op.
QUERY_PACK coherence_report [queries=[c_uncovered_usecases c_orphan_scenarios c_unrealized_then_steps loan_ends loan_steps operations_of_the_client], must_return=[loan_ends loan_steps operations_of_the_client]].
DSL_PROFILE loan_profile [query_pack=coherence_report, planner_hint=high_selectivity_first].
