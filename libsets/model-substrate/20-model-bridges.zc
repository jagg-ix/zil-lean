MODULE model.substrate.bridges.

// Coverage bridges. Contract: spec/model-substrate-v0.1.md.
// target is any ID: an operation, a transition, a message, an entity, or a domain ID.

MACRO MODEL_COVERED_BY(uc, scenario):
EMIT {{uc}}#model_covered_by@{{scenario}}.
ENDMACRO.

MACRO SCENARIO_REALIZES(step, target):
EMIT {{step}}#scenario_realizes@{{target}}.
ENDMACRO.
