MODULE model.substrate.structure.

// Shared structure macros. Contract: spec/model-substrate-v0.1.md.
//
// Arguments are opaque IDs. They are substituted verbatim and never prefixed, so a
// domain library can pass its own IDs and refer to the same subjects.
// Facts read "A rel B" for the tuple A#rel@B.

MACRO MODEL_ENTITY(id):
EMIT {{id}}#model_kind@entity:model_entity.
ENDMACRO.

MACRO MODEL_ATTR(attr, owner, type):
EMIT {{attr}}#model_kind@entity:model_attr.
EMIT {{owner}}#model_has_attr@{{attr}}.
EMIT {{attr}}#model_type@{{type}}.
ENDMACRO.

MACRO MODEL_OP(op, owner):
EMIT {{op}}#model_kind@entity:model_op.
EMIT {{owner}}#model_has_op@{{op}}.
ENDMACRO.

MACRO MODEL_ASSOC(assoc, source, target, source_mult, target_mult):
EMIT {{assoc}}#model_kind@entity:model_assoc.
EMIT {{assoc}}#model_source@{{source}}.
EMIT {{assoc}}#model_target@{{target}}.
EMIT {{assoc}}#model_source_mult@value:{{source_mult}}.
EMIT {{assoc}}#model_target_mult@value:{{target_mult}}.
ENDMACRO.

MACRO MODEL_GENERALIZE(child, parent):
EMIT {{child}}#model_is_a@{{parent}}.
ENDMACRO.

MACRO MODEL_STATE(state, owner):
EMIT {{state}}#model_kind@entity:model_state.
EMIT {{owner}}#model_has_state@{{state}}.
ENDMACRO.

MACRO MODEL_INITIAL(state):
EMIT {{state}}#model_initial@value:true.
ENDMACRO.

MACRO MODEL_TRANS(trans, from, event, to):
EMIT {{trans}}#model_kind@entity:model_transition.
EMIT {{trans}}#model_from@{{from}}.
EMIT {{trans}}#model_event@value:{{event}}.
EMIT {{trans}}#model_to@{{to}}.
ENDMACRO.

MACRO MODEL_MSG(msg, from, to, op):
EMIT {{msg}}#model_kind@entity:model_message.
EMIT {{msg}}#model_from@{{from}}.
EMIT {{msg}}#model_to@{{to}}.
EMIT {{msg}}#model_calls@{{op}}.
ENDMACRO.

MACRO MODEL_MSG_AFTER(later, earlier):
EMIT {{later}}#model_after@{{earlier}}.
ENDMACRO.
