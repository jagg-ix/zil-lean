tlm:channel:read_bus#to@tlm:component:mem0.
tlm:channel:read_bus#timing_profile@tlm:timing:bus_timing.
tlm:bind:cpu0_read_bus_initiator#kind@entity:tlm_binding.
tlm:bind:cpu0_read_bus_initiator#component@tlm:component:cpu0.
