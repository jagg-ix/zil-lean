cfg:entry:base_defaults:web:bind_port#value@value:8096.
cfg:block:base_defaults:web#timeout_ms@value:5000.
cfg:block:base_defaults:web#retry_count@value:4.
cfg:block:base_defaults:web#retry_backoff_ms@value:200.
feature:base_defaults:web:image_ingest#kind@entity:config_feature.
feature:base_defaults:web:image_ingest#in_document@config:base_defaults.
feature:base_defaults:web:image_ingest#in_block@cfg:block:base_defaults:web.
feature:base_defaults:web:image_ingest#flag@value:image_ingest.
feature:base_defaults:web:image_ingest#enabled@value:true.
cfg:block:base_defaults:web#schedule_cron@value:"*/5 * * * *".
cfg:block:base_defaults:web#schedule_tz@value:"UTC".
cfg:list_item:base_defaults:web:allowed_origins:0#kind@entity:config_list_item.
