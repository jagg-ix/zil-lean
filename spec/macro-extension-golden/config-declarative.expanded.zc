cfg:list_item:base_defaults:web:allowed_origins:1#in_block@cfg:block:base_defaults:web.
cfg:list_item:base_defaults:web:allowed_origins:1#key@value:allowed_origins.
cfg:list_item:base_defaults:web:allowed_origins:1#index@value:1.
cfg:list_item:base_defaults:web:allowed_origins:1#value@value:"http://127.0.0.1:8091".
DATASOURCE cfgdoc_runtime_prod [type=file, format=yaml, path="configs/runtime-prod.yaml"].
config:runtime_prod#kind@entity:config_document.
config:runtime_prod#format@value:yaml.
config:runtime_prod#path@"configs/runtime-prod.yaml".
config:runtime_prod#source@datasource:cfgdoc_runtime_prod.
