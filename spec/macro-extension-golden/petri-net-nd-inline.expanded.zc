pi:proc:p_recv#channel@pi:name:ch_conn.
pi:proc:p_recv#bind@pi:name:v_bound.
pi:proc:p_recv#next@pi:proc:p0.
pi:proc:p_sync#kind@entity:pi_process.
pi:proc:p_sync#operator@value:par.
pi:proc:p_sync#left@pi:proc:p_send.
pi:proc:p_sync#right@pi:proc:p_recv.
pn:transition:t_upgrade_channel#pi_process@pi:proc:p_sync.
