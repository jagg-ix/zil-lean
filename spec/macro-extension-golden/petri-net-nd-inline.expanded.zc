pi:proc:p0#operator@value:nil.
pi:proc:p_send#kind@entity:pi_process.
pi:proc:p_send#operator@value:send.
pi:proc:p_send#channel@pi:name:ch_conn.
pi:proc:p_send#payload@pi:name:v_conn.
pi:proc:p_send#next@pi:proc:p0.
pi:proc:p_recv#kind@entity:pi_process.
