TM_ATOM handshake_unit [states=#{idle done reject}, alphabet=#{conn _}, blank=_, initial=idle, accept=#{done}, reject=#{reject}, transitions={[idle conn] [done conn :N], [idle _] [reject _ :N]}].
pn:transition:t_upgrade_channel#tm_machine@tm_atom:handshake_unit.
pn:transition:t_upgrade_channel#tm_map@tm_atom:handshake_unit [from_state=idle, read_symbol=conn, to_state=done, write_symbol=conn, move=:N].
