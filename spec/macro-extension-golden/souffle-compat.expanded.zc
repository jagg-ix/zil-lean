MODULE souffle.compat.transitive_closure.
souffle:relation_edge#kind@entity:souffle_relation.
souffle:relation_edge#arity@value:2.
souffle:relation_edge#column_0_type@value:symbol.
souffle:relation_edge#column_1_type@value:symbol.
souffle:relation_path#kind@entity:souffle_relation.
souffle:relation_path#arity@value:2.
souffle:relation_path#column_0_type@value:symbol.
souffle:relation_path#column_1_type@value:symbol.
b#edge@a.
c#edge@b.
d#edge@c.
RULE path_base:
IF ?y#edge@?x
THEN ?y#path@?x.
RULE path_recursive:
IF ?y#edge@?x AND ?z#path@?y
THEN ?z#path@?x.
QUERY reachable_pairs:
FIND ?x ?y WHERE ?y#path@?x.
