RULE aws_has_control_category:
IF ?c#kind@entity:aws_control AND ?c#category@?cat
THEN aws:catalog#has_control_category@?cat.
RULE aws_missing_required_service:
IF ?m#kind@entity:aws_compat_target AND ?m#requires_service@?svc AND NOT ?svc#kind@entity:aws_service
THEN ?m#missing_required_service@?svc.
RULE aws_missing_required_region:
IF ?m#kind@entity:aws_compat_target AND ?m#requires_region@?r AND NOT ?r#kind@entity:aws_region
THEN ?m#missing_required_region@?r.
RULE aws_missing_required_control_category:
IF ?m#kind@entity:aws_compat_target AND ?m#requires_control_category@?cat AND NOT aws:catalog#has_control_category@?cat
THEN ?m#missing_required_control_category@?cat.
RULE aws_missing_required_config_key:
IF ?m#kind@entity:aws_compat_target AND ?m#uses_config@?cfg AND ?m#requires_config_key@?key AND NOT ?cfg#has_key@?key
THEN ?m#missing_required_config_key@?key.
RULE aws_has_missing_any_from_service:
IF ?m#missing_required_service@?svc
THEN ?m#has_missing_any@value:true.
RULE aws_has_missing_any_from_region:
IF ?m#missing_required_region@?r
THEN ?m#has_missing_any@value:true.
RULE aws_has_missing_any_from_control:
IF ?m#missing_required_control_category@?cat
THEN ?m#has_missing_any@value:true.
RULE aws_has_missing_any_from_config:
IF ?m#missing_required_config_key@?key
THEN ?m#has_missing_any@value:true.
RULE aws_target_compat_ready:
IF ?m#kind@entity:aws_compat_target AND NOT ?m#has_missing_any@value:true
THEN ?m#compat_ready@value:true.
RULE aws_service_icon_missing:
IF ?s#icon_concept@?icon
THEN ?s#has_icon@value:true.
RULE aws_service_icon_missing:
IF ?s#kind@entity:aws_service AND NOT ?s#has_icon@value:true
THEN ?s#icon_missing@value:true.
QUERY aws_compat_missing_services:
FIND ?m ?svc WHERE ?m#missing_required_service@?svc.
QUERY aws_compat_missing_regions:
FIND ?m ?region WHERE ?m#missing_required_region@?region.
QUERY aws_compat_missing_control_categories:
FIND ?m ?cat WHERE ?m#missing_required_control_category@?cat.
QUERY aws_compat_missing_config_keys:
FIND ?m ?key WHERE ?m#missing_required_config_key@?key.
QUERY aws_compat_ready_models:
FIND ?m WHERE ?m#compat_ready@value:true.
QUERY aws_icon_concepts:
FIND ?icon ?family WHERE ?icon#kind@entity:aws_icon_concept AND ?icon#family@?family.
QUERY aws_service_icon_links:
FIND ?svc ?icon WHERE ?svc#icon_concept@?icon.
QUERY aws_services_missing_icons:
FIND ?svc WHERE ?svc#icon_missing@value:true.
RULE aws_ns_visible_service:
IF ?ctx#visible_name@?name AND ?ref#kind@entity:aws_namespace_service_ref AND ?ref#context@?ctx AND ?ref#local_name@?name AND ?ref#service@?svc
THEN ?ctx#visible_service@?svc.
RULE aws_ns_visible_region:
IF ?ctx#visible_name@?name AND ?ref#kind@entity:aws_namespace_region_ref AND ?ref#context@?ctx AND ?ref#local_name@?name AND ?ref#region@?region
THEN ?ctx#visible_region@?region.
RULE aws_ns_scoped_has_required_service:
IF ?m#kind@entity:aws_compat_target AND ?m#scope_ctx@?ctx AND ?m#requires_service@?svc AND ?ctx#visible_service@?svc
THEN ?m#scoped_has_required_service@?svc.
RULE aws_ns_scoped_missing_required_service:
IF ?m#kind@entity:aws_compat_target AND ?m#scope_ctx@?ctx AND ?m#requires_service@?svc AND NOT ?m#scoped_has_required_service@?svc
THEN ?m#scoped_missing_required_service@?svc.
RULE aws_ns_scoped_has_required_region:
IF ?m#kind@entity:aws_compat_target AND ?m#scope_ctx@?ctx AND ?m#requires_region@?region AND ?ctx#visible_region@?region
THEN ?m#scoped_has_required_region@?region.
RULE aws_ns_scoped_missing_required_region:
IF ?m#kind@entity:aws_compat_target AND ?m#scope_ctx@?ctx AND ?m#requires_region@?region AND NOT ?m#scoped_has_required_region@?region
THEN ?m#scoped_missing_required_region@?region.
RULE aws_ns_scoped_missing_marks_target_from_service:
IF ?m#scoped_missing_required_service@?svc
THEN ?m#has_missing_any@value:true.
RULE aws_ns_scoped_missing_marks_target_from_region:
IF ?m#scoped_missing_required_region@?region
THEN ?m#has_missing_any@value:true.
QUERY aws_ns_target_scopes:
FIND ?m ?ctx WHERE ?m#scope_ctx@?ctx.
QUERY aws_ns_visible_services:
FIND ?ctx ?svc WHERE ?ctx#visible_service@?svc.
QUERY aws_ns_visible_regions:
FIND ?ctx ?region WHERE ?ctx#visible_region@?region.
QUERY aws_ns_scoped_missing_services:
FIND ?m ?svc WHERE ?m#scoped_missing_required_service@?svc.
QUERY aws_ns_scoped_missing_regions:
FIND ?m ?region WHERE ?m#scoped_missing_required_region@?region.
RULE ns_dim_next_transitive:
IF ?d1#next@?d2 AND ?d2#next@?d3
THEN ?d1#next@?d3.
RULE ns_descendant_direct:
IF ?p#child@?c
THEN ?p#descendant@?c.
RULE ns_descendant_transitive:
IF ?p#descendant@?m AND ?m#child@?c
THEN ?p#descendant@?c.
RULE ns_context_has_local_name:
IF ?b#kind@entity:ns_binding AND ?b#context@?ctx AND ?b#local_name@?name
THEN ?ctx#has_local_name@?name.
RULE ns_visible_name_local:
IF ?ctx#has_local_name@?name
THEN ?ctx#visible_name@?name.
RULE ns_visible_name_from_ancestor:
IF ?ancestor#descendant@?ctx AND ?ancestor#has_local_name@?name
THEN ?ctx#visible_name@?name.
RULE ns_visible_name_alias:
IF ?a#kind@entity:ns_alias AND ?a#src_ctx@?src AND ?a#src_name@?src_name AND ?a#dst_ctx@?dst AND ?a#dst_name@?dst_name AND ?dst#visible_name@?dst_name
THEN ?src#visible_name@?src_name.
RULE ns_morphism_reach_direct:
IF ?m#kind@entity:ns_morphism AND ?m#src@?src AND ?m#dst@?dst
THEN ?src#morphism_reaches@?dst.
RULE ns_morphism_reach_from_child:
IF ?src#child@?dst
THEN ?src#morphism_reaches@?dst.
RULE ns_morphism_reach_transitive:
IF ?a#morphism_reaches@?b AND ?b#morphism_reaches@?c
THEN ?a#morphism_reaches@?c.
RULE ns_product_projection_left_visible:
IF ?pc#product@value:true AND ?pc#proj_left@?l AND ?l#visible_name@?name
THEN ?pc#visible_name@?name.
RULE ns_product_projection_right_visible:
IF ?pc#product@value:true AND ?pc#proj_right@?r AND ?r#visible_name@?name
THEN ?pc#visible_name@?name.
RULE ns_product_dimension_valid:
IF ?pc#product@value:true AND ?pc#dimension@?dp AND ?pc#proj_left@?l AND ?pc#proj_right@?r AND ?l#dimension@?dl AND ?r#dimension@?dr AND ?dl#next@?dp AND ?dr#next@?dp
THEN ?pc#product_dimension_valid@value:true.
RULE ns_transition_enabled:
IF ?tr#kind@entity:ns_pn_transition AND ?tr#from@?ctx AND ?tok#kind@entity:ns_name_token AND ?tok#context@?ctx
THEN ?tr#enabled_by@?tok.
RULE ns_token_can_move_to_transition_target:
IF ?tr#enabled_by@?tok AND ?tr#to@?dst
THEN ?tok#can_move_to@?dst.
RULE ns_token_resolution_witness:
IF ?tr#enabled_by@?tok AND ?tok#name@?name AND ?tr#to@?dst AND ?dst#visible_name@?name
THEN ?tok#resolution_witness@?dst.
QUERY namespace_hierarchy_edges:
FIND ?parent ?child WHERE ?parent#child@?child.
QUERY namespace_descendants:
FIND ?ancestor ?desc WHERE ?ancestor#descendant@?desc.
QUERY namespace_visible_names:
FIND ?ctx ?name WHERE ?ctx#visible_name@?name.
QUERY namespace_product_contexts:
FIND ?ctx ?ok WHERE ?ctx#product@value:true AND ?ctx#product_dimension_valid@?ok.
QUERY namespace_morphism_reachability:
FIND ?src ?dst WHERE ?src#morphism_reaches@?dst.
QUERY namespace_transition_enabling:
FIND ?tr ?tok WHERE ?tr#enabled_by@?tok.
QUERY namespace_resolution_witnesses:
FIND ?tok ?dst WHERE ?tok#resolution_witness@?dst.
QUERY namespace_binding_conflict_pairs:
FIND ?ctx ?name ?b1 ?b2 WHERE ?b1#kind@entity:ns_binding AND ?b2#kind@entity:ns_binding AND ?b1#context@?ctx AND ?b2#context@?ctx AND ?b1#local_name@?name AND ?b2#local_name@?name.
