pi:proc:customer_send#channel@pi:name:payment.
pi:proc:customer_send#payload@pi:name:order_total.
pi:proc:customer_send#next@pi:proc:finished.
pi:proc:shop_receive#kind@entity:pi_process.
pi:proc:shop_receive#operator@value:recv.
pi:proc:shop_receive#channel@pi:name:payment.
pi:proc:shop_receive#bind@pi:name:amount.
pi:proc:shop_receive#next@pi:proc:finished.
