RULE tpl_patient_visible:
IF ?p#operator@value:prefix AND ?p#action@?a AND ?a#class@value:visible
THEN ?p#can_sigma@value:true.
RULE tpl_tau_blocks_tick:
IF ?p#operator@value:prefix AND ?p#action@?a AND ?a#class@value:tau
THEN ?p#blocks_tick@value:true.
RULE tpl_internal_may_stall:
IF ?p#side@value:internal AND ?p#can_sigma@value:true
THEN ?p#stalls_external@value:true.
RULE tpl_external_blocks_time:
IF ?p#side@value:external AND ?p#blocks_tick@value:true
THEN ?p#stalls_time@value:true.
RULE pi_sync_tau:
IF ?p#operator@value:par AND ?p#left@?s AND ?p#right@?r AND ?s#operator@value:send AND ?r#operator@value:recv AND ?s#channel@?c AND ?r#channel@?c
THEN ?p#can_tau@value:true.
RULE pi_step_stuck:
IF ?p#operator@value:par AND NOT ?p#can_tau@value:true
THEN ?p#stuck@value:true.
RULE vc_lt_transitive:
IF ?a#lt@?b AND ?b#lt@?c
THEN ?a#lt@?c.
RULE vc_witness:
IF ?e1#vc_counter@?actor [counter=?c1] AND ?e2#vc_counter@?actor [counter=?c2] AND ?c1#lt@?c2
THEN ?e1#witness@?e2.
RULE vc_violation:
IF ?e1#vc_counter@?actor [counter=?c1] AND ?e2#vc_counter@?actor [counter=?c2] AND ?c2#lt@?c1
THEN ?e1#violation@?e2.
RULE vc_before:
IF ?e1#kind@entity:vc_event AND ?e2#kind@entity:vc_event AND ?e1#distinct_from@?e2 AND ?e1#witness@?e2 AND NOT ?e1#violation@?e2
THEN ?e1#before@?e2.
RULE vc_order_kept:
IF ?a#must_precede@?b AND ?a#before@?b
THEN ?a#order_kept@?b.
RULE vc_order_broken:
IF ?a#must_precede@?b AND NOT ?a#before@?b
THEN ?a#order_broken@?b.
RULE time_before_transitive:
IF ?a#earlier@?b AND ?b#earlier@?c
THEN ?a#earlier@?c.
RULE time_le_from_before:
IF ?a#earlier@?b
THEN ?a#le@?b.
RULE time_within_window:
IF ?o#age@?a AND ?o#limit@?l AND ?a#le@?l
THEN ?o#within_window@value:true.
RULE time_past_window:
IF ?o#age@?a AND ?o#limit@?l AND ?l#earlier@?a
THEN ?o#past_window@value:true.
MODULE process.algebra.checks.example.
