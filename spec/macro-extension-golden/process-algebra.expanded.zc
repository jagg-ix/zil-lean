pi:proc:broken_checkout#right@pi:proc:lonely_receive.
vc:actor:shop#kind@entity:vc_actor.
vc:actor:carrier#kind@entity:vc_actor.
vc:ctr:c1#kind@entity:vc_counter.
vc:ctr:c2#kind@entity:vc_counter.
vc:ctr:c3#kind@entity:vc_counter.
vc:ctr:c1#lt@vc:ctr:c2.
vc:ctr:c2#lt@vc:ctr:c3.
vc:event:packed#kind@entity:vc_event.
vc:event:shipped#kind@entity:vc_event.
vc:event:delivered#kind@entity:vc_event.
vc:event:packed#vc_counter@vc:actor:shop [counter=vc:ctr:c1].
vc:event:shipped#vc_counter@vc:actor:shop [counter=vc:ctr:c2].
vc:event:delivered#vc_counter@vc:actor:shop [counter=vc:ctr:c1].
vc:event:packed#must_precede@vc:event:shipped.
vc:event:packed#distinct_from@vc:event:shipped.
vc:event:shipped#distinct_from@vc:event:packed.
vc:event:shipped#must_precede@vc:event:delivered.
vc:event:shipped#distinct_from@vc:event:delivered.
vc:event:delivered#distinct_from@vc:event:shipped.
time:tick:t0#kind@entity:time_tick.
time:tick:t0#le@time:tick:t0.
time:tick:t5#kind@entity:time_tick.
time:tick:t5#le@time:tick:t5.
time:tick:t30#kind@entity:time_tick.
time:tick:t30#le@time:tick:t30.
time:tick:t0#earlier@time:tick:t5.
time:tick:t5#earlier@time:tick:t30.
time:op:fresh_quote#age@time:tick:t5.
time:op:fresh_quote#limit@time:tick:t30.
time:op:stale_quote#age@time:tick:t30.
time:op:stale_quote#limit@time:tick:t5.
time:op:old_quote#age@time:tick:t30.
time:op:old_quote#limit@time:tick:t0.
time:op:boundary_quote#age@time:tick:t30.
time:op:boundary_quote#limit@time:tick:t30.
QUERY internal_steps_that_may_stall:
FIND ?p WHERE ?p#stalls_external@value:true.
QUERY external_steps_that_hold_time_up:
FIND ?p WHERE ?p#stalls_time@value:true.
QUERY handoffs_with_no_partner:
FIND ?p WHERE ?p#stuck@value:true.
QUERY handoffs_that_can_step:
FIND ?p WHERE ?p#can_tau@value:true.
QUERY orders_kept:
FIND ?a ?b WHERE ?a#order_kept@?b.
QUERY orders_broken:
FIND ?a ?b WHERE ?a#order_broken@?b.
QUERY quotes_within_window:
FIND ?o WHERE ?o#within_window@value:true.
QUERY quotes_past_window:
FIND ?o WHERE ?o#past_window@value:true.
QUERY_PACK checkout_pack [queries=[internal_steps_that_may_stall external_steps_that_hold_time_up handoffs_with_no_partner handoffs_that_can_step orders_kept orders_broken quotes_within_window quotes_past_window], must_return=[handoffs_that_can_step]].
DSL_PROFILE checkout_profile [query_pack=checkout_pack, planner_hint=high_selectivity_first, verification_chain=[query_ci]].
