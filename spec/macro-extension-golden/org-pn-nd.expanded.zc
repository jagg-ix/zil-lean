RULE nd_dim_next_transitive:
IF ?d1#next@?d2 AND ?d2#next@?d3
THEN ?d1#next@?d3.
RULE nd_space_embedding_transitive:
IF ?s1#kind@entity:nd_space AND ?s1#space_embeds_into@?s2 AND ?s2#kind@entity:nd_space AND ?s2#space_embeds_into@?s3 AND ?s3#kind@entity:nd_space
THEN ?s1#space_embeds_into@?s3.
RULE nd_space_embedding_step_valid:
IF ?s1#kind@entity:nd_space AND ?s1#space_embeds_into@?s2 AND ?s2#kind@entity:nd_space AND ?s1#dimension@?d1 AND ?s2#dimension@?d2 AND ?d1#direct_next@?d2
THEN ?s1#embedding_step_valid@?s2.
RULE sw_layer_embedding_valid:
IF ?l1#kind@entity:sw_layer AND ?l1#layer_embeds_into@?l2 AND ?l2#kind@entity:sw_layer AND ?l1#space@?s1 AND ?l2#space@?s2 AND ?s1#space_embeds_into@?s2
THEN ?l1#embedding_valid@?l2.
RULE org_uses_nd_space_through_net:
IF ?org#kind@entity:organization AND ?org#uses_net@?net AND ?net#models_space@?space
THEN ?org#uses_nd_space@?space.
RULE sw_link_space_alignment:
IF ?link#kind@entity:sw_layer_link AND ?link#from@?from AND ?link#to@?to AND ?from#space@?s1 AND ?to#space@?s2 AND ?s1#space_embeds_into@?s2
THEN ?link#space_alignment@value:upward_embed.
RULE sw_link_embedding_alignment:
IF ?link#kind@entity:sw_layer_link AND ?link#from@?from AND ?link#to@?to AND ?from#embedding_valid@?to
THEN ?link#embedding_alignment@value:valid.
RULE pn_has_reactive_rule:
IF ?net#has_lppn_rule@?r AND ?r#rule_kind@value:reactive
THEN ?net#has_reactive_rule@value:true.
RULE pn_has_declarative_rule:
IF ?net#has_lppn_rule@?r AND ?r#rule_kind@value:declarative
THEN ?net#has_declarative_rule@value:true.
RULE pn_lppn_hybrid:
IF ?net#has_reactive_rule@value:true AND ?net#has_declarative_rule@value:true
THEN ?net#lppn_hybrid@value:true.
QUERY orgs_using_petrinet_nd_spaces:
FIND ?org ?net ?space WHERE ?org#uses_net@?net AND ?net#models_space@?space.
QUERY nd_space_embeddings:
FIND ?lower ?upper WHERE ?lower#kind@entity:nd_space AND ?lower#space_embeds_into@?upper AND ?upper#kind@entity:nd_space.
QUERY nd_embedding_steps_valid:
FIND ?lower ?upper WHERE ?lower#embedding_step_valid@?upper.
QUERY sw_embedding_valid_pairs:
FIND ?lower ?upper WHERE ?lower#embedding_valid@?upper.
QUERY sw_links_alignment:
FIND ?link ?alignment WHERE ?link#kind@entity:sw_layer_link AND ?link#embedding_alignment@?alignment.
QUERY lppn_hybrid_nets:
FIND ?net WHERE ?net#lppn_hybrid@value:true.
MODULE org.pn.nd.embedding.demo.
org:acme_ops#kind@entity:organization.
org:acme_ops#org_type@value:enterprise.
pn:net:acme_flow#kind@entity:pn_net.
pn:net:acme_flow#profile@value:lppn.
org:acme_ops#uses_net@pn:net:acme_flow.
nd:dim:d1#kind@entity:nd_dimension.
nd:dim:d1#rank@value:1.
nd:dim:d2#kind@entity:nd_dimension.
nd:dim:d2#rank@value:2.
nd:dim:d3#kind@entity:nd_dimension.
nd:dim:d3#rank@value:3.
nd:dim:d1#direct_next@nd:dim:d2.
nd:dim:d1#next@nd:dim:d2.
nd:dim:d2#direct_next@nd:dim:d3.
nd:dim:d2#next@nd:dim:d3.
nd:space:transport_space#kind@entity:nd_space.
nd:space:transport_space#dimension@nd:dim:d1.
nd:space:protocol_space#kind@entity:nd_space.
nd:space:protocol_space#dimension@nd:dim:d2.
nd:space:operations_space#kind@entity:nd_space.
nd:space:operations_space#dimension@nd:dim:d3.
nd:space:transport_space#space_embeds_into@nd:space:protocol_space.
nd:space:protocol_space#space_embeds_into@nd:space:operations_space.
nd:link:link_s_tp#kind@entity:nd_space_link.
nd:link:link_s_tp#from@nd:space:transport_space.
nd:link:link_s_tp#to@nd:space:protocol_space.
nd:link:link_s_tp#link_kind@value:upgrade.
nd:link:link_s_po#kind@entity:nd_space_link.
nd:link:link_s_po#from@nd:space:protocol_space.
nd:link:link_s_po#to@nd:space:operations_space.
nd:link:link_s_po#link_kind@value:elevate.
pn:net:acme_flow#models_space@nd:space:transport_space.
pn:net:acme_flow#models_space@nd:space:protocol_space.
pn:net:acme_flow#models_space@nd:space:operations_space.
sw:layer:l_transport#kind@entity:sw_layer.
sw:layer:l_transport#space@nd:space:transport_space.
sw:layer:l_transport#layer_role@value:transport.
sw:layer:l_protocol#kind@entity:sw_layer.
sw:layer:l_protocol#space@nd:space:protocol_space.
sw:layer:l_protocol#layer_role@value:protocol.
sw:layer:l_ops#kind@entity:sw_layer.
sw:layer:l_ops#space@nd:space:operations_space.
sw:layer:l_ops#layer_role@value:operations.
sw:layer:l_transport#layer_embeds_into@sw:layer:l_protocol.
sw:layer:l_protocol#layer_embeds_into@sw:layer:l_ops.
sw:link:link_l_tp#kind@entity:sw_layer_link.
sw:link:link_l_tp#from@sw:layer:l_transport.
sw:link:link_l_tp#to@sw:layer:l_protocol.
sw:link:link_l_tp#protocol@value:overlay.
sw:link:link_l_po#kind@entity:sw_layer_link.
sw:link:link_l_po#from@sw:layer:l_protocol.
sw:link:link_l_po#to@sw:layer:l_ops.
sw:link:link_l_po#protocol@value:mcp.
lppn:rule:r_flow_progress#kind@entity:lppn_rule.
lppn:rule:r_flow_progress#rule_kind@value:reactive.
lppn:rule:r_flow_progress#net@pn:net:acme_flow.
pn:net:acme_flow#has_lppn_rule@lppn:rule:r_flow_progress.
lppn:rule:r_model_consistency#kind@entity:lppn_rule.
lppn:rule:r_model_consistency#rule_kind@value:declarative.
lppn:rule:r_model_consistency#net@pn:net:acme_flow.
pn:net:acme_flow#has_lppn_rule@lppn:rule:r_model_consistency.
