api_method:bookshelf_shelves_create#kind@entity:api_method.
api_method:bookshelf_shelves_create#method_in_api@gcp_api:bookshelf.
api_method:bookshelf_shelves_create#mutating_method_in_api@gcp_api:bookshelf.
api_method:bookshelf_shelves_create#http_method@"POST".
api_method:bookshelf_shelves_create#http_method_present@true.
api_method:bookshelf_shelves_create#endpoint_path_present@true.
api_method:bookshelf_shelves_create#oauth_scope_present@true.
api_method:bookshelf_shelves_create#request_schema_expected@true.
api_method:bookshelf_shelves_create#request_schema_resolved@true.
api_method:bookshelf_shelves_create#response_schema_expected@true.
api_method:bookshelf_shelves_create#response_schema_resolved@true.
api_method:bookshelf_shelves_probe#kind@entity:api_method.
api_method:bookshelf_shelves_probe#method_in_api@gcp_api:bookshelf.
api_method:bookshelf_shelves_probe#http_method@"TRACE".
api_method:bookshelf_shelves_probe#http_method_present@true.
api_method:bookshelf_shelves_probe#endpoint_path_present@true.
api_method:bookshelf_shelves_probe#oauth_scope_present@true.
api_method:bookshelf_shelves_probe#request_schema_expected@true.
api_method:bookshelf_shelves_remove#kind@entity:api_method.
api_method:bookshelf_shelves_remove#method_in_api@gcp_api:bookshelf.
api_method:bookshelf_shelves_remove#mutating_method_in_api@gcp_api:bookshelf.
api_method:bookshelf_shelves_remove#http_method@"DELETE".
api_method:bookshelf_shelves_remove#http_method_present@true.
api_method:bookshelf_shelves_remove#endpoint_path_present@true.
api_method:bookshelf_shelves_remove#response_schema_expected@true.
api_method:bookshelf_shelves_orphan#kind@entity:api_method.
api_method:bookshelf_shelves_orphan#method_in_api@gcp_api:bookshelf.
api_schema:bookshelf_Shelf#kind@entity:api_schema.
api_schema:bookshelf_Shelf#schema_in_api@gcp_api:bookshelf.
api_schema:bookshelf_ShelfList#kind@entity:api_schema.
api_schema:bookshelf_ShelfList#schema_in_api@gcp_api:bookshelf.
schema_field:bookshelf_Shelf_name#kind@entity:schema_field.
schema_field:bookshelf_Shelf_name#field_in_api@gcp_api:bookshelf.
schema_field:bookshelf_Shelf_name#field_type@"string".
schema_field:bookshelf_Shelf_tags#kind@entity:schema_field.
schema_field:bookshelf_Shelf_tags#field_in_api@gcp_api:bookshelf.
schema_field:bookshelf_Shelf_tags#field_type@"array".
schema_field:bookshelf_Shelf_owner#kind@entity:schema_field.
schema_field:bookshelf_Shelf_owner#field_in_api@gcp_api:bookshelf.
schema_field:bookshelf_Shelf_owner#field_type@"reference".
