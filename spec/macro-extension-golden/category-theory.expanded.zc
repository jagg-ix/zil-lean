QUERY ct_categories:
FIND ?c WHERE ?c#kind@entity:ct_category.
QUERY ct_morphisms:
FIND ?m ?dom ?cod WHERE ?m#kind@entity:ct_morphism AND ?m#domain@?dom AND ?m#codomain@?cod.
QUERY ct_functors:
FIND ?f ?src ?tgt WHERE ?f#kind@entity:ct_functor AND ?f#from_cat@?src AND ?f#to_cat@?tgt.
QUERY ct_nat_transforms:
FIND ?n ?f ?g WHERE ?n#kind@entity:ct_nat_trans AND ?n#from_fun@?f AND ?n#to_fun@?g.
QUERY ct_isomorphisms:
FIND ?i ?m WHERE ?i#kind@entity:ct_isomorphism AND ?i#morphism@?m.
QUERY ct_lean4_evidence:
FIND ?e ?mod ?name WHERE ?e#engine@engine:lean4 AND ?e#module@?mod AND ?e#lean4_name@?name.
QUERY ct_unproved_lemmas:
FIND ?lemma WHERE ?lemma#kind@entity:thm_lemma AND NOT ?lemma#has_proof@value:true.
QUERY dsl_theorem_statuses:
FIND ?theorem ?status WHERE ?theorem#kind@entity:theorem AND ?theorem#status@?status.
QUERY dsl_conditional_dependencies:
FIND ?theorem ?dep WHERE ?theorem#conditional_on@?dep.
QUERY dsl_break_roots:
FIND ?node WHERE ?node#is_break_root@value:true.
QUERY dsl_impact_set:
FIND ?theorem ?root WHERE ?theorem#kind@entity:theorem AND ?theorem#impacted_by_root@?root.
