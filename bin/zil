#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ZIL_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

native_help() {
  cat <<'EOF'
Usage:
  bin/zil self-check [--report FILE]
  bin/zil setup [--profile PROFILE] [--install-tools] [--test]
  bin/zil doctor [--profile PROFILE] [--report FILE]
  bin/zil test [--profile PROFILE] [--report FILE] [--keep-workdir]
  bin/zil test-container [test-options...]
  bin/zil package [--format tar.gz|dir] [--output DIR]
  bin/zil install [--prefix DIR] [--mode copy|link] [--profile PROFILE]
  bin/zil verify-install [--prefix DIR] [--structural|--smoke]
  bin/zil uninstall [--prefix DIR] [--purge]
  bin/zil test-install [--report FILE] [--keep-workdir]
  bin/zil compile <input.zc> [output.lean|-] [namespace] [--lib DIR]
  bin/zil expand <input.zc> [output.zc|-] [--lib DIR]
  bin/zil conformance <input.zc> [output.zilc|-]
  bin/zil corpus [--update]
  bin/zil query-plan <input.zc> [output.txt|-]
  bin/zil query-ci <input.zc> [profile|-] [output.txt|-]
  bin/zil trace <input.zc> [output.txt|-]
  bin/zil explain-query <input.zc> <query> [output.txt|-]
  bin/zil explain-authorization <input.zc> <object> <relation> <subject> [output.txt|-]
  bin/zil dependency-graph <input.zc> [output.txt|-]
  bin/zil impact <input.zc> <changed-node> [output.txt|-]
  bin/zil action-token <input.zc> <request-node> [output|-]
  bin/zil token-lifecycle <input.zc> <request-node> [output|-]
  bin/zil recovery-audit <input.zc> <request-node> [output|-]
  bin/zil agent-context <input.zc> <task-id> <agent-id> <scope> <changed-nodes> [queries|-] [targets|-] [output|-]
  bin/zil proof-obligations <input.zc> [tool|-] [output|-]
  bin/zil theorem-audit <input.zc> [output|-]
  bin/zil formalization-plan <input.zc> [output.txt|-]
  bin/zil formalization-next <input.zc> [output.txt|-]
  bin/zil authorize <input.zc> <object> <relation> <subject> [output.txt|-]
  bin/zil revision-summary <input.zilr>
  bin/zil snapshot <input.zilr> <revision> [output.txt|-]
  bin/zil causal-check <input.zilr>
  bin/zil worker [--stdio|--once]

Self-check validates installation scripts and configuration without building Lean.
Package exports committed source with SHA-256 manifests. Install supports immutable
copied roots and linked development roots. Verification and uninstall protect
installer-owned state. Test-install exercises the complete lifecycle under a temporary
prefix without building Lean.

Setup is non-destructive by default. Use --install-tools to install a missing Elan in
user space. Doctor emits ZIL-DOCTOR/1 reports. Test profiles emit ZIL-TEST-REPORT/1
reports, persistent step logs, and isolated generated outputs.

Worker exposes the allowlisted ZIL-EXCHANGE/1 JSON Lines protocol. Lean is authoritative
for parse, compile, expand, conformance, query, authorize, impact, and recovery-audit.

Corpus compiles every .zc file under lib/, libsets/ and examples/ with the native
compiler and compares the result with spec/corpus-status.tsv. The macro libraries are
qualified by tools/macro_extension_matrix.sh.

Action-token validates preflight evidence and token intent. Token-lifecycle replays
checkpoint binding and single-use execution with revision, expiry, lease, store,
and observed-output hash checks.

Recovery-audit verifies required postconditions and validates any recovery against
the exact rollback or compensation precommitted by the issued token.

Comma-separated name lists are used by agent-context. The canonical report bytes
may be hashed as the durable context_bundle_id for action-token issuance.

Proof-obligations accepts all, -, z3, tlaps, lean4, acl2, or manual. Native
governance audits evidence and status but does not pretend to execute external solvers.

Theorem-audit checks theorem non-vacuity, dependencies, guarantees, proof evidence,
and the external claim boundary. It does not promote graph support to kernel proof.

Without --lib, compile and expand read the file alone. A model that uses macros from a
library is given that library with --lib DIR (a directory of .zc files, composed in sorted
order before the model).
EOF
}

run_self_check() {
  shift
  cd "$ZIL_ROOT"
  exec bash scripts/self-check.sh "$@"
}

run_setup() {
  shift
  cd "$ZIL_ROOT"
  exec bash scripts/setup.sh "$@"
}

run_doctor() {
  shift
  cd "$ZIL_ROOT"
  exec bash scripts/doctor.sh "$@"
}

run_tests() {
  shift
  cd "$ZIL_ROOT"
  exec bash scripts/test.sh "$@"
}

run_package() {
  shift
  cd "$ZIL_ROOT"
  exec bash scripts/package.sh "$@"
}

run_install() {
  shift
  cd "$ZIL_ROOT"
  exec bash scripts/install.sh "$@"
}

run_verify_install() {
  shift
  cd "$ZIL_ROOT"
  exec bash scripts/verify-install.sh "$@"
}

run_uninstall() {
  shift
  cd "$ZIL_ROOT"
  exec bash scripts/uninstall.sh "$@"
}

run_install_test() {
  shift
  cd "$ZIL_ROOT"
  exec bash scripts/install-lifecycle-test.sh "$@"
}

run_test_container() {
  shift
  if ! command -v docker >/dev/null 2>&1; then
    echo "[zil] docker is required for the container test workbench" >&2
    exit 2
  fi
  if ! docker compose version >/dev/null 2>&1; then
    echo "[zil] the docker compose plugin is required for container tests" >&2
    exit 2
  fi
  cd "$ZIL_ROOT"
  mkdir -p .zil/container-reports
  exec docker compose -f compose.test.yml run --rm zil-test "$@"
}

run_native() {
  if ! command -v lake >/dev/null 2>&1; then
    echo "[zil] lake is required for the native CLI" >&2
    exit 2
  fi
  cd "$ZIL_ROOT"
  exec lake exe zil "$@"
}

run_worker() {
  shift
  if ! command -v lake >/dev/null 2>&1; then
    echo "[zil] lake is required for the native exchange worker" >&2
    exit 2
  fi
  cd "$ZIL_ROOT"
  exec lake exe zilWorker "$@"
}

run_action_token() {
  shift
  if ! command -v lake >/dev/null 2>&1; then
    echo "[zil] lake is required for native action-token issuance" >&2
    exit 2
  fi
  cd "$ZIL_ROOT"
  exec lake exe zilActionToken "$@"
}

run_token_lifecycle() {
  shift
  if ! command -v lake >/dev/null 2>&1; then
    echo "[zil] lake is required for native token lifecycle auditing" >&2
    exit 2
  fi
  cd "$ZIL_ROOT"
  exec lake exe zilTokenLifecycle "$@"
}

run_recovery_audit() {
  shift
  if ! command -v lake >/dev/null 2>&1; then
    echo "[zil] lake is required for native recovery auditing" >&2
    exit 2
  fi
  cd "$ZIL_ROOT"
  exec lake exe zilRecoveryAudit "$@"
}

run_agent_context() {
  shift
  if ! command -v lake >/dev/null 2>&1; then
    echo "[zil] lake is required for native agent context generation" >&2
    exit 2
  fi
  cd "$ZIL_ROOT"
  exec lake exe zilAgentContext "$@"
}

run_proof_obligations() {
  shift
  if ! command -v lake >/dev/null 2>&1; then
    echo "[zil] lake is required for native proof obligation governance" >&2
    exit 2
  fi
  cd "$ZIL_ROOT"
  exec lake exe zilProofObligations "$@"
}

run_theorem_audit() {
  shift
  if ! command -v lake >/dev/null 2>&1; then
    echo "[zil] lake is required for native theorem auditing" >&2
    exit 2
  fi
  cd "$ZIL_ROOT"
  exec lake exe zilTheoremAudit "$@"
}

last_clojure_commit="bf130927edd3ecdad959173d1e63d59130864909"

removed_command() {
  local name="$1" use
  case "$name" in
    macro-compile) use="bin/zil compile <input.zc> [output.lean|-] [namespace] --lib DIR" ;;
    macro-expand) use="bin/zil expand <input.zc> [output.zc|-] --lib DIR" ;;
    macro-parity) use="tools/macro_extension_matrix.sh (native expansion against reviewed goldens; there is no second frontend to compare with)" ;;
    library|conformance-suite) use="bin/zil corpus (native compile of every source against spec/corpus-status.tsv)" ;;
    *) use="nothing: the feature was part of the Clojure runtime and was removed with it" ;;
  esac
  echo "[zil] '$name' was removed with the Clojure runtime." >&2
  echo "      Use: $use" >&2
  echo "      The last commit that still had it is $last_clojure_commit." >&2
  exit 2
}

command_name="${1:-}"

case "$command_name" in
  self-check)
    run_self_check "$@"
    ;;
  setup)
    run_setup "$@"
    ;;
  doctor)
    run_doctor "$@"
    ;;
  test)
    run_tests "$@"
    ;;
  test-container)
    run_test_container "$@"
    ;;
  package)
    run_package "$@"
    ;;
  install)
    run_install "$@"
    ;;
  verify-install)
    run_verify_install "$@"
    ;;
  uninstall)
    run_uninstall "$@"
    ;;
  test-install)
    run_install_test "$@"
    ;;
  compile|expand|conformance|query-plan|query-ci|trace|explain-query|explain-authorization|dependency-graph|impact|formalization-plan|formalization-next|authorize|revision-summary|snapshot|causal-check)
    run_native "$@"
    ;;
  worker)
    run_worker "$@"
    ;;
  action-token)
    run_action_token "$@"
    ;;
  token-lifecycle)
    run_token_lifecycle "$@"
    ;;
  recovery-audit)
    run_recovery_audit "$@"
    ;;
  agent-context)
    run_agent_context "$@"
    ;;
  proof-obligations)
    run_proof_obligations "$@"
    ;;
  theorem-audit)
    run_theorem_audit "$@"
    ;;
  corpus)
    shift
    cd "$ZIL_ROOT"
    exec bash scripts/check-corpus.sh "$@"
    ;;
  exchange|control|control-store|evaluate-runtime|plugin|embedded-native|library|conformance-suite|macro-compile|macro-expand|macro-parity|--legacy)
    removed_command "$command_name"
    ;;
  --help|-h)
    native_help
    exit 0
    ;;
  "")
    native_help >&2
    exit 2
    ;;
  *)
    echo "[zil] '$command_name' is not a command. Run bin/zil --help." >&2
    exit 2
    ;;
esac
